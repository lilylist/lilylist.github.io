---
import { getCollection } from 'astro:content';

const photos = await getCollection('gallery');
const rotations = [-2, 1.5, -1, 2.5, -1.5, 1, 2, -2.5, 0.5, 1.5, -1, 0.5];
const bgColors = ['bg-warmwhite', 'bg-corals', 'bg-electriclight', 'bg-pinklight', 'bg-goldenlight', 'bg-mintlight'];
---

<section id="gallery" class="bg-paper relative noise-bg">
  <div class="section-container relative z-10">
    <div class="mb-16">
      <span class="tag-pill bg-corals mb-4 inline-flex" data-i18n="gallery.label">06 — GALLERY</span>
      <h2 class="section-title reveal" data-i18n="gallery.title">Gallery</h2>
      <p class="section-subtitle reveal reveal-delay-1" data-i18n="gallery.subtitle">Moments captured</p>
    </div>

    {photos.length > 0 ? (
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {photos.map((photo, i) => (
          <div class={`reveal reveal-delay-${(i % 4) + 1} group cursor-pointer`} data-gallery-item>
            <div class={`${bgColors[i % bgColors.length]} p-3 pb-8 rounded-sm border-2 border-charcoal shadow-[4px_4px_0px_#1A1A1A] hover:shadow-[8px_8px_0px_#6C5CE7] transition-all duration-300 hover:-translate-y-2 hover:rotate-0`} style={`transform: rotate(${rotations[i % rotations.length]}deg)`}>
              <div class="aspect-square overflow-hidden rounded-sm relative">
                <img src={photo.data.photo} alt={photo.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" data-gallery-img data-caption={photo.data.caption || photo.data.title} />
                <div class="absolute inset-0 bg-charcoal/0 group-hover:bg-charcoal/20 transition-all duration-300 flex items-center justify-center">
                  <svg class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 drop-shadow-lg" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                  </svg>
                </div>
              </div>
              {photo.data.caption && (
                <p class="mt-3 text-[11px] font-display font-bold text-stone text-center truncate">{photo.data.caption}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-20">
        <div class="bold-card p-12 max-w-md mx-auto">
          <div class="text-6xl mb-4">📸</div>
          <p class="text-gray font-display font-semibold" data-i18n="gallery.empty">Photos will appear here in a polaroid-style wall. Upload via the CMS!</p>
        </div>
      </div>
    )}
  </div>
</section>
