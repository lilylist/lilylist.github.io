---
import { getCollection } from 'astro:content';

const photos = await getCollection('gallery');
const rotations = [-3, 2, -1, 4, -2, 1, 3, -4, 0, 2, -3, 1];
---

<section id="gallery" class="bg-white/50">
  <div class="section-container">
    <div class="text-center mb-16">
      <h2 class="section-title reveal" data-i18n="gallery.title">Gallery</h2>
      <p class="section-subtitle reveal reveal-delay-1" data-i18n="gallery.subtitle">Moments captured</p>
    </div>

    {photos.length > 0 ? (
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {photos.map((photo, i) => (
          <div class={`reveal reveal-delay-${(i % 4) + 1} group cursor-pointer`} data-gallery-item>
            <div class="bg-white p-3 pb-6 rounded-sm shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 hover:rotate-0" style={`transform: rotate(${rotations[i % rotations.length]}deg)`}>
              <div class="aspect-square overflow-hidden rounded-sm relative">
                <img src={photo.data.photo} alt={photo.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" data-gallery-img data-caption={photo.data.caption || photo.data.title} />
                <!-- Hover overlay -->
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-all duration-300 flex items-center justify-center rounded-sm">
                  <svg class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 drop-shadow-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                  </svg>
                </div>
              </div>
              {photo.data.caption && (
                <p class="mt-3 text-xs text-warmgray text-center truncate">{photo.data.caption}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <div class="glass-card p-12 max-w-md mx-auto">
          <div class="text-5xl mb-4">📸</div>
          <p class="text-warmgray" data-i18n="gallery.empty">Photos will appear here in a polaroid-style wall. Upload via the CMS!</p>
        </div>
      </div>
    )}
  </div>
</section>
