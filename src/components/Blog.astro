---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => data.date <= new Date());
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<section id="blog" class="bg-warmwhite relative zigzag-bg">
  <div class="section-container relative z-10">
    <div class="mb-16">
      <span class="tag-pill bg-mint mb-4 inline-flex" data-i18n="blog.label">04 — BLOG</span>
      <h2 class="section-title reveal" data-i18n="blog.title">Blog</h2>
      <p class="section-subtitle reveal reveal-delay-1" data-i18n="blog.subtitle">Thoughts, tutorials, and discoveries</p>
    </div>

    {posts.length > 0 ? (
      <div class="grid md:grid-cols-2 gap-6">
        {posts.slice(0, 6).map((post, i) => (
          <article class={`reveal reveal-delay-${(i % 4) + 1} bold-card p-6 group hover:-translate-y-1 transition-all duration-300 ${i % 3 === 0 ? '' : i % 3 === 1 ? 'bold-card-coral' : 'bold-card-pink'}`}>
            {post.data.cover && (
              <div class="aspect-[16/9] rounded-xl overflow-hidden mb-4 border-2 border-charcoal">
                <img src={post.data.cover} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
            )}
            <div class="flex items-center gap-3 mb-3">
              <span class="badge bg-electriclight text-electric">
                <span class="w-1.5 h-1.5 bg-electric rounded-full"></span>
                <time class="text-xs font-display font-bold">
                  {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </span>
              {post.data.tags && post.data.tags.slice(0, 2).map(tag => (
                <span class="text-[10px] font-display font-bold text-gray uppercase tracking-wider px-2 py-0.5 bg-lightgray/20 rounded-full">{tag}</span>
              ))}
            </div>
            <h3 class="font-display text-lg font-black text-charcoal mb-2 group-hover:text-electric transition-colors leading-tight">
              {post.data.title}
            </h3>
            <p class="text-sm text-gray leading-relaxed">{post.data.excerpt}</p>
            <div class="mt-4 flex items-center text-electric text-xs font-display font-bold uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity">
              Read More →
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="text-center py-20">
        <div class="bold-card p-12 max-w-md mx-auto">
          <div class="text-6xl mb-4">✍️</div>
          <p class="text-gray font-display font-semibold" data-i18n="blog.empty">Blog posts will appear here. Start writing via the CMS!</p>
        </div>
      </div>
    )}
  </div>
</section>
