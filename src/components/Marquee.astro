---
const items = [
  '✦ CREATIVE DEVELOPER',
  '◆ UI/UX PASSION',
  '✦ OPEN SOURCE',
  '◆ LIFELONG LEARNER',
  '✦ PROBLEM SOLVER',
  '◆ CODE & DESIGN',
  '✦ BUILD THINGS',
  '◆ SHARE KNOWLEDGE',
  '✦ COFFEE FUELED',
  '◆ DREAM IN PIXELS',
];
---

<div class="bg-charcoal text-white py-5 overflow-hidden relative">
  <!-- Gradient edges -->
  <div class="absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-charcoal to-transparent z-10 pointer-events-none"></div>
  <div class="absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-charcoal to-transparent z-10 pointer-events-none"></div>

  <div class="marquee-track">
    {[...items, ...items].map((item, i) => (
      <span key={i} class="font-display font-black text-sm md:text-base uppercase tracking-[0.15em] whitespace-nowrap text-white/80 hover:text-white transition-colors">
        {item}
      </span>
    ))}
  </div>
</div>
