---
---

<section id="about" class="relative noise-bg">
  <div class="section-container relative z-10">
    <!-- Section header -->
    <div class="mb-16">
      <span class="tag-pill mb-4 inline-flex" data-i18n="about.label">01 — ABOUT</span>
      <div class="flex items-end justify-between flex-wrap gap-4">
        <h2 class="section-title reveal" data-i18n="about.title">About Me</h2>
        <div class="reveal reveal-delay-1 w-16 h-16 bg-goldenlight rounded-2xl rotate-6 flex items-center justify-center shrink-0">
          <span class="text-3xl">👋</span>
        </div>
      </div>
    </div>

    <div class="grid lg:grid-cols-5 gap-8">
      <!-- Bio card -->
      <div class="lg:col-span-3 reveal reveal-delay-1">
        <div class="bold-card p-8 md:p-10 h-full">
          <p class="text-lg md:text-xl leading-relaxed text-graphite mb-6" data-i18n="about.p1">
            I'm lilylist, a computer engineer who loves building elegant solutions to complex problems. When I'm not writing code, you'll find me exploring new technologies, documenting my learning journey, or designing creative side projects.
          </p>
          <p class="text-lg md:text-xl leading-relaxed text-graphite mb-8" data-i18n="about.p2">
            I believe in writing clean, maintainable code and creating interfaces that feel as good as they look. I'm passionate about open source, continuous learning, and sharing knowledge with the community.
          </p>
          <div class="flex flex-wrap gap-3">
            <span class="tag-pill" data-i18n="about.tag1">Open Source</span>
            <span class="tag-pill bg-hotpink" data-i18n="about.tag2">Clean Code</span>
            <span class="tag-pill bg-mint" data-i18n="about.tag3">Lifelong Learner</span>
          </div>
        </div>
      </div>

      <!-- Stats -->
      <div class="lg:col-span-2 reveal reveal-delay-2">
        <div class="grid grid-cols-2 gap-4">
          <div class="bold-card p-6 text-center bold-card-coral">
            <div class="text-4xl md:text-5xl font-display font-black gradient-text mb-1">10+</div>
            <div class="text-xs font-display font-bold text-gray uppercase tracking-wider" data-i18n="about.stat_projects">Projects</div>
          </div>
          <div class="bold-card p-6 text-center bold-card-pink">
            <div class="text-4xl md:text-5xl font-display font-black gradient-text mb-1">50+</div>
            <div class="text-xs font-display font-bold text-gray uppercase tracking-wider" data-i18n="about.stat_posts">Blog Posts</div>
          </div>
          <div class="bold-card p-6 text-center bold-card-mint">
            <div class="text-4xl md:text-5xl font-display font-black gradient-text mb-1">3+</div>
            <div class="text-xs font-display font-bold text-gray uppercase tracking-wider" data-i18n="about.stat_years">Years Exp</div>
          </div>
          <div class="bold-card p-6 text-center">
            <div class="text-4xl md:text-5xl font-display font-black gradient-text mb-1">∞</div>
            <div class="text-xs font-display font-bold text-gray uppercase tracking-wider" data-i18n="about.stat_curiosity">Curiosity</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
