---
---

<footer class="bg-charcoal text-white relative overflow-hidden">
  <!-- Decorative top border -->
  <div class="h-2 bg-gradient-to-r from-corals via-electric via-hotpink to-mint"></div>

  <div class="section-container !py-16 relative z-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <!-- Logo -->
      <div class="flex items-center gap-3">
        <span class="w-9 h-9 bg-electric rounded-md flex items-center justify-center text-white text-sm font-display font-black">L</span>
        <span class="font-display text-2xl font-black gradient-text-warm">lilylist</span>
      </div>

      <!-- Links -->
      <div class="flex items-center gap-6 text-sm font-display font-bold uppercase tracking-wider">
        <span class="text-lightgray" data-i18n="footer.built_with">Built with</span>
        <span class="text-electric">Astro</span>
        <span class="text-lightgray" data-i18n="footer.and">&</span>
        <span class="text-hotpink">Tailwind</span>
      </div>

      <!-- GitHub -->
      <a href="https://github.com/lilylist" target="_blank" class="w-10 h-10 border-2 border-white/30 rounded-full flex items-center justify-center hover:bg-electric hover:border-electric transition-all" aria-label="GitHub">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
    </div>

    <div class="mt-8 pt-8 border-t border-white/10 text-center">
      <p class="text-sm text-gray font-mono">© {new Date().getFullYear()} lilylist — Made with ♡ and lots of ☕</p>
    </div>
  </div>
</footer>
