---
---

<footer class="bg-charcoal text-white relative overflow-hidden">
  <!-- Decorative top -->
  <div class="h-1.5 animated-gradient"></div>
  <!-- Big decorative shapes -->
  <div class="absolute top-10 right-[5%] w-40 h-40 border border-white/5 rounded-full pointer-events-none"></div>
  <div class="absolute bottom-10 left-[8%] w-24 h-24 border border-white/5 rounded-lg rotate-12 pointer-events-none"></div>

  <div class="section-container !py-20 relative z-10">
    <div class="flex flex-col items-center text-center mb-12">
      <span class="w-12 h-12 bg-electric rounded-xl flex items-center justify-center text-white text-lg font-display font-black mb-6" aria-hidden="true">L</span>
      <h3 class="font-display text-3xl md:text-4xl font-black mb-3 gradient-text-warm">lilylist</h3>
      <p class="text-lightgray max-w-md" data-i18n="footer.tagline">
        Building things with code, writing about the journey, and sharing what I learn.
      </p>
    </div>

    <!-- Divider -->
    <div class="w-full h-px bg-gradient-to-r from-transparent via-white/20 to-transparent mb-10"></div>

    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4 text-sm font-display font-bold uppercase tracking-wider text-lightgray">
        <span data-i18n="footer.built_with">Built with</span>
        <span class="px-2 py-0.5 bg-electric/20 text-electric rounded text-xs">Astro</span>
        <span data-i18n="footer.and">&</span>
        <span class="px-2 py-0.5 bg-hotpink/20 text-hotpink rounded text-xs">Tailwind</span>
      </div>

      <div class="flex items-center gap-3">
        <a href="https://github.com/lilylist" target="_blank" rel="noopener noreferrer" class="w-10 h-10 border-2 border-white/20 rounded-full flex items-center justify-center hover:bg-electric hover:border-electric transition-all" aria-label="GitHub profile">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="mt-10 pt-8 border-t border-white/10 text-center">
      <p class="text-sm text-gray font-mono">© {new Date().getFullYear()} lilylist — Made with ♡ and lots of ☕</p>
    </div>
  </div>
</footer>
