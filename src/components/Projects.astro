---
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<section id="projects" class="bg-white/50">
  <div class="section-container">
    <div class="text-center mb-16">
      <h2 class="section-title reveal" data-i18n="projects.title">Projects</h2>
      <p class="section-subtitle reveal reveal-delay-1" data-i18n="projects.subtitle">Things I've built and contributed to</p>
    </div>

    {projects.length > 0 ? (
      <div class="grid md:grid-cols-2 gap-8">
        {projects.map((project, i) => (
          <article
            class={`reveal reveal-delay-${(i % 4) + 1} glass-card overflow-hidden group hover:shadow-xl transition-all duration-300 cursor-pointer hover:-translate-y-1`}
            onclick={`openModal(\`
              <div class='p-8'>
                ${project.data.cover ? `<div class='rounded-2xl overflow-hidden mb-6'><img src='${project.data.cover}' alt='${project.data.title}' class='w-full aspect-video object-cover' /></div>` : ''}
                <h2 class='font-display text-2xl font-bold text-stone-900 mb-3'>${project.data.title}</h2>
                <p class='text-warmgray mb-4 leading-relaxed'>${project.data.description}</p>
                ${project.data.tech ? `<div class='flex flex-wrap gap-2 mb-6'>${project.data.tech.map(t => `<span class='px-3 py-1 bg-lavender rounded-full text-xs text-deeppurple font-medium'>${t}</span>`).join('')}</div>` : ''}
                <div class='flex gap-4'>
                  ${project.data.url ? `<a href='${project.data.url}' target='_blank' class='btn-primary text-sm'>Live Demo →</a>` : ''}
                  ${project.data.repo ? `<a href='${project.data.repo}' target='_blank' class='btn-ghost text-sm'>View Code</a>` : ''}
                </div>
              </div>
            \`)`}
          >
            {project.data.cover && (
              <div class="aspect-video overflow-hidden relative">
                <img src={project.data.cover} alt={project.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                  <span class="text-white text-sm font-medium flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    View Details
                  </span>
                </div>
              </div>
            )}
            <div class="p-6">
              <h3 class="font-display text-xl font-semibold text-stone-900 mb-2 group-hover:text-deeppurple transition-colors">{project.data.title}</h3>
              <p class="text-warmgray text-sm mb-4 line-clamp-2">{project.data.description}</p>

              {project.data.tech && (
                <div class="flex flex-wrap gap-2 mb-4">
                  {project.data.tech.slice(0, 4).map(t => (
                    <span class="px-3 py-1 bg-lavender rounded-full text-xs text-deeppurple">{t}</span>
                  ))}
                  {project.data.tech.length > 4 && (
                    <span class="px-3 py-1 bg-stone-100 rounded-full text-xs text-warmgray">+{project.data.tech.length - 4}</span>
                  )}
                </div>
              )}

              <div class="flex gap-4">
                {project.data.url && (
                  <span class="text-sm text-deeppurple flex items-center gap-1" data-i18n="projects.live">Live →</span>
                )}
                {project.data.repo && (
                  <span class="text-sm text-warmgray flex items-center gap-1">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                    Code
                  </span>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <div class="glass-card p-12 max-w-md mx-auto">
          <div class="text-5xl mb-4">🚀</div>
          <p class="text-warmgray" data-i18n="projects.empty">Projects will appear here once you add them via the CMS!</p>
        </div>
      </div>
    )}
  </div>
</section>
