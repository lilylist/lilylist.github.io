---
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<section id="projects" class="bg-paper relative striped-bg">
  <div class="section-container relative z-10">
    <div class="mb-16">
      <span class="tag-pill bg-electric mb-4 inline-flex" data-i18n="projects.label">02 — WORK</span>
      <h2 class="section-title reveal" data-i18n="projects.title">Projects</h2>
      <p class="section-subtitle reveal reveal-delay-1" data-i18n="projects.subtitle">Things I've built and contributed to</p>
    </div>

    {projects.length > 0 ? (
      <div class="grid md:grid-cols-2 gap-6">
        {projects.map((project, i) => (
          <article
            class={`reveal reveal-delay-${(i % 4) + 1} bold-card overflow-hidden group cursor-pointer hover:-translate-y-1 transition-all duration-300`}
            onclick={`openModal(\`
              <div class='p-8 md:p-10'>
                ${project.data.cover ? `<div class='rounded-xl overflow-hidden mb-6 border-2 border-charcoal'><img src='${project.data.cover}' alt='${project.data.title}' class='w-full aspect-video object-cover' /></div>` : ''}
                <span class='tag-pill bg-electric mb-3 inline-flex'>PROJECT</span>
                <h2 class='font-display text-3xl font-black text-charcoal mb-3'>${project.data.title}</h2>
                <p class='text-stone mb-6 leading-relaxed'>${project.data.description}</p>
                ${project.data.tech ? `<div class='flex flex-wrap gap-2 mb-6'>${project.data.tech.map(t => `<span class='tag-pill-outline text-[10px]'>${t}</span>`).join('')}</div>` : ''}
                <div class='flex gap-4'>
                  ${project.data.url ? `<a href='${project.data.url}' target='_blank' class='btn-primary text-xs'>Live Demo →</a>` : ''}
                  ${project.data.repo ? `<a href='${project.data.repo}' target='_blank' class='btn-outline text-xs'>View Code</a>` : ''}
                </div>
              </div>
            \`)`}
          >
            {project.data.cover && (
              <div class="aspect-[16/10] overflow-hidden relative border-b-[3px] border-charcoal">
                <img src={project.data.cover} alt={project.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                <div class="absolute inset-0 bg-charcoal/0 group-hover:bg-charcoal/20 transition-all duration-300 flex items-center justify-center">
                  <span class="bg-white text-charcoal font-display font-bold text-xs uppercase tracking-wider px-4 py-2 rounded-full border-2 border-charcoal shadow-[3px_3px_0px_#1A1A1A] opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-2 group-hover:translate-y-0">
                    View Details →
                  </span>
                </div>
              </div>
            )}
            <div class="p-6">
              <h3 class="font-display text-xl font-black text-charcoal mb-2 group-hover:text-electric transition-colors">{project.data.title}</h3>
              <p class="text-gray text-sm mb-4 line-clamp-2">{project.data.description}</p>

              {project.data.tech && (
                <div class="flex flex-wrap gap-2">
                  {project.data.tech.slice(0, 3).map(t => (
                    <span class="px-3 py-1 bg-electriclight rounded-full text-[10px] font-display font-bold text-electric uppercase tracking-wider">{t}</span>
                  ))}
                  {project.data.tech.length > 3 && (
                    <span class="px-3 py-1 bg-lightgray/20 rounded-full text-[10px] font-display font-bold text-gray">+{project.data.tech.length - 3}</span>
                  )}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="text-center py-20">
        <div class="bold-card p-12 max-w-md mx-auto">
          <div class="text-6xl mb-4">🚀</div>
          <p class="text-gray font-display font-semibold" data-i18n="projects.empty">Projects will appear here once you add them via the CMS!</p>
        </div>
      </div>
    )}
  </div>
</section>
