---
const navLinks = [
  { label: 'About', key: 'nav.about', href: '#about' },
  { label: 'Projects', key: 'nav.projects', href: '#projects' },
  { label: 'Skills', key: 'nav.skills', href: '#skills' },
  { label: 'Blog', key: 'nav.blog', href: '#blog' },
  { label: 'Timeline', key: 'nav.timeline', href: '#timeline' },
  { label: 'Gallery', key: 'nav.gallery', href: '#gallery' },
  { label: 'Contact', key: 'nav.contact', href: '#contact' }
];
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-stone-100/50 transition-all duration-300">
  <div class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href="#" class="font-display text-lg font-bold gradient-text shrink-0">lilylist</a>

    <div class="hidden md:flex items-center gap-0.5">
      {navLinks.map(link => (
        <a href={link.href} class="text-[13px] text-warmgray hover:text-deeppurple transition-colors px-2.5 py-1.5 rounded-md hover:bg-lavender/50 whitespace-nowrap" data-i18n={link.key}>
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <!-- Language toggle integrated in navbar -->
      <button id="nav-lang-toggle" class="text-xs font-medium text-warmgray hover:text-deeppurple border border-stone-200 hover:border-deeppurple rounded-full px-3 py-1.5 transition-all" data-i18n="lang.toggle">
        中文
      </button>

      <button id="menu-toggle" class="md:hidden p-2 rounded-lg hover:bg-lavender/50 transition-colors" aria-label="Toggle menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden bg-white/95 backdrop-blur-md border-b border-stone-100 px-6 py-4">
    {navLinks.map(link => (
      <a href={link.href} class="block py-2 text-warmgray hover:text-deeppurple transition-colors" data-i18n={link.key}>
        {link.label}
      </a>
    ))}
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Language toggle in navbar
  document.getElementById('nav-lang-toggle')?.addEventListener('click', () => {
    const current = localStorage.getItem('lang') || 'en';
    const next = current === 'en' ? 'zh' : 'en';
    localStorage.setItem('lang', next);
    document.documentElement.lang = next === 'zh' ? 'zh-CN' : 'en';
    // Trigger the same translation logic
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      const dict = (next === 'zh') ? window.i18nZh : window.i18nEn;
      if (dict && dict[key]) el.textContent = dict[key];
    });
    // Update toggle label
    el = document.getElementById('nav-lang-toggle');
    if (el) el.textContent = next === 'en' ? '中文' : 'EN';
  });

  // Hide/show nav on scroll
  const nav = document.getElementById('main-nav');
  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    if (currentScroll > 100 && currentScroll > lastScroll) {
      nav?.classList.add('-translate-y-full');
    } else {
      nav?.classList.remove('-translate-y-full');
    }
    lastScroll = currentScroll;
  });
</script>
