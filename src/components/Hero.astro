---

<section class="min-h-screen flex items-center justify-center relative overflow-hidden dots-bg pt-16">
  <div class="absolute top-20 left-10 w-72 h-72 bg-softpurple/30 rounded-full blur-3xl animate-float"></div>
  <div class="absolute bottom-20 right-10 w-96 h-96 bg-lavender/40 rounded-full blur-3xl animate-float" style="animation-delay: -3s"></div>

  <div class="section-container text-center relative z-10">
    <div class="reveal">
      <div class="mb-8">
        <div class="w-28 h-28 mx-auto rounded-full bg-gradient-to-br from-deeppurple to-pink-400 flex items-center justify-center text-white text-4xl font-display font-bold shadow-xl shadow-purple-200/50">
          L
        </div>
      </div>

      <p class="text-xl md:text-2xl text-warmgray mb-2" data-i18n="hero.greeting">Hi, I'm</p>

      <h1 class="font-display text-5xl md:text-7xl font-bold text-stone-900 mb-6 text-balance">
        <span class="gradient-text">lilylist</span>
      </h1>

      <p class="text-xl md:text-2xl text-warmgray mb-4 font-light" data-i18n="hero.tagline">
        a pretty girl computer engineer
      </p>

      <p class="text-warmgray max-w-lg mx-auto mb-10 leading-relaxed" data-i18n="hero.description">
        Building things with code, writing about the journey, and sharing what I learn along the way.
      </p>

      <div class="flex items-center justify-center gap-4">
        <a href="#projects" class="btn-primary" data-i18n="hero.cta_work">
          See My Work
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </a>
        <a href="#contact" class="btn-ghost" data-i18n="hero.cta_contact">Get in Touch</a>
      </div>
    </div>

    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-warmgray" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </div>
  </div>
</section>
