---
---

<section class="min-h-screen flex items-center relative overflow-hidden pt-20 pb-16 noise-bg">
  <!-- Decorative shapes (behind content) with parallax -->
  <div class="hidden md:block absolute top-24 right-[10%] w-40 h-40 border-[3px] border-charcoal rounded-full opacity-20 animate-blob parallax-element" style="z-index:1" data-parallax-speed="0.15"></div>
  <div class="hidden md:block absolute bottom-32 left-[5%] w-28 h-28 bg-coral/20 rounded-2xl rotate-12 animate-wiggle parallax-element" style="z-index:1" data-parallax-speed="0.25"></div>
  <div class="absolute top-1/4 left-[3%] w-12 h-12 md:w-16 md:h-16 bg-electriclight/40 rounded-lg -rotate-12 parallax-element" style="z-index:1" data-parallax-speed="0.35"></div>
  <div class="hidden md:block absolute bottom-20 right-[15%] w-20 h-20 border-2 border-hotpink rounded-full opacity-30 parallax-element" style="z-index:1" data-parallax-speed="0.2"></div>
  <!-- Extra decorations -->
  <div class="hidden lg:block absolute top-40 left-[20%] w-8 h-8 bg-golden rounded-full opacity-30 animate-float" style="z-index:1"></div>
  <div class="hidden lg:block absolute bottom-48 right-[30%] w-6 h-6 bg-mint rounded-sm rotate-45 opacity-40 animate-float-slow" style="z-index:1"></div>
  <!-- Large blur blob -->
  <div class="absolute top-1/3 right-[8%] w-72 h-72 bg-electric/5 rounded-full blur-3xl pointer-events-none" style="z-index:0"></div>
  <!-- Dot grid overlay -->
  <div class="absolute inset-0 dots-bg opacity-40 pointer-events-none" style="z-index:0"></div>

  <div class="section-container relative w-full" style="z-index:2">
    <div class="max-w-4xl">
      <!-- Eyebrow -->
      <div class="reveal inline-flex items-center gap-2 mb-6">
        <span class="w-2 h-2 bg-mint rounded-full animate-pulse"></span>
        <span class="tag-pill-outline text-[11px]" data-i18n="hero.status">AVAILABLE FOR WORK</span>
      </div>

      <!-- Main heading -->
      <h1 class="reveal reveal-delay-1 font-display text-5xl md:text-8xl lg:text-9xl font-black leading-[0.9] tracking-tighter text-charcoal mb-6">
        <span data-i18n="hero.greeting">Hi, I'm</span><br/>
        <span class="gradient-text">lilylist</span><br/>
        <span class="text-charcoal/20 inline-block rotate-[-2deg] text-3xl md:text-6xl">♡</span>
      </h1>

      <!-- Tagline -->
      <p class="reveal reveal-delay-2 text-xl md:text-2xl font-display font-semibold text-stone mb-3" data-i18n="hero.tagline">
        a pretty girl computer engineer
      </p>

      <!-- Description -->
      <p class="reveal reveal-delay-2 text-base md:text-lg text-gray max-w-xl mb-10 leading-relaxed" data-i18n="hero.description">
        Building things with code, writing about the journey, and sharing what I learn along the way.
      </p>

      <!-- CTAs -->
      <div class="reveal reveal-delay-3 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <a href="#projects" class="btn-primary justify-center text-xs md:text-sm" data-i18n="hero.cta_work">
          <span>See My Work</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="#contact" class="btn-outline justify-center text-xs md:text-sm" data-i18n="hero.cta_contact">
          Get in Touch
        </a>
      </div>

      <!-- Social links -->
      <div class="reveal reveal-delay-4 mt-12 flex items-center gap-4">
        <a href="https://github.com/lilylist" target="_blank" class="w-11 h-11 border-2 border-charcoal rounded-full flex items-center justify-center text-charcoal hover:bg-charcoal hover:text-white transition-all duration-300 hover:-translate-y-1" aria-label="GitHub">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

</section>
