---
const nowItems = [
  { icon: '🎓', label: 'Learning', value: 'Rust & WebAssembly' },
  { icon: '📖', label: 'Reading', value: 'Designing Data-Intensive Applications' },
  { icon: '🎧', label: 'Listening', value: 'Lo-fi & synthwave' },
  { icon: '🌱', label: 'Growing', value: 'My plant collection (12 and counting!)' },
  { icon: '💡', label: 'Building', value: 'A real-time collab whiteboard' },
  { icon: '☕', label: 'Drinking', value: 'Ethiopian single-origin pour over' },
];
---

<section id="now" class="bg-charcoal text-white relative overflow-hidden">
  <!-- Decorative blobs -->
  <div class="absolute top-0 right-0 w-64 h-64 bg-electric/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-48 h-48 bg-hotpink/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="section-container relative z-10">
    <div class="mb-14">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-3 h-3 bg-mint rounded-full animate-pulse"></span>
        <span class="text-mint font-display font-bold text-sm uppercase tracking-wider" data-i18n="now.label">What I'm Doing Now</span>
      </div>
      <h2 class="font-display text-4xl md:text-6xl font-black leading-tight" data-i18n="now.title">
        Current <span class="text-transparent bg-clip-text bg-gradient-to-r from-mint via-electric to-hotpink">obsessions</span>
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {nowItems.map((item, i) => (
        <div class={`reveal-scale border-2 border-white/10 rounded-xl p-5 hover:border-electric/50 hover:bg-white/5 transition-all duration-300 group`} style={`transition-delay: ${i * 0.08}s`}>
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">{item.icon}</span>
            <span class="text-xs font-display font-bold text-lightgray uppercase tracking-wider">{item.label}</span>
          </div>
          <p class="font-display font-semibold text-white/90 group-hover:text-white transition-colors">{item.value}</p>
        </div>
      ))}
    </div>

    <p class="mt-10 text-lightgray/60 text-sm font-mono" data-i18n="now.updated">
      Last updated: October 2026
    </p>
  </div>
</section>
