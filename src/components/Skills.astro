---
const skillCategories = [
  {
    title: 'Languages', i18nKey: 'skills.cat1', icon: '💻',
    skills: ['JavaScript', 'TypeScript', 'Python', 'Java', 'Go', 'SQL']
  },
  {
    title: 'Frontend', i18nKey: 'skills.cat2', icon: '🎨',
    skills: ['React', 'Next.js', 'Astro', 'Tailwind CSS', 'Vue', 'GSAP']
  },
  {
    title: 'Backend', i18nKey: 'skills.cat3', icon: '⚙️',
    skills: ['Node.js', 'Express', 'FastAPI', 'PostgreSQL', 'Redis', 'Docker']
  },
  {
    title: 'Tools & Practices', i18nKey: 'skills.cat4', icon: '🛠️',
    skills: ['Git', 'CI/CD', 'Testing', 'REST APIs', 'GraphQL', 'Agile']
  }
];
---

<section id="skills">
  <div class="section-container">
    <div class="text-center mb-16">
      <h2 class="section-title reveal" data-i18n="skills.title">Skills</h2>
      <p class="section-subtitle reveal reveal-delay-1" data-i18n="skills.subtitle">Technologies and tools I work with</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {skillCategories.map((cat, i) => (
        <div class={`reveal reveal-delay-${(i % 4) + 1} glass-card p-8`}>
          <div class="flex items-center gap-3 mb-6">
            <span class="text-3xl">{cat.icon}</span>
            <h3 class="font-display text-xl font-semibold text-stone-900" data-i18n={cat.i18nKey}>{cat.title}</h3>
          </div>
          <div class="flex flex-wrap gap-3">
            {cat.skills.map(skill => (
              <span class="px-4 py-2 bg-gradient-to-r from-lavender to-blush rounded-full text-sm font-medium text-stone-700 hover:shadow-md transition-shadow cursor-default">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
