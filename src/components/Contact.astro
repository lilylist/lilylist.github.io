---
---

<section id="contact" class="relative overflow-hidden noise-bg">
  <!-- Decorative -->
  <div class="absolute top-20 right-[5%] w-32 h-32 border-[3px] border-charcoal rounded-full opacity-10"></div>
  <div class="absolute bottom-20 left-[8%] w-20 h-20 bg-corals/20 rounded-2xl rotate-12"></div>

  <div class="section-container relative z-10">
    <div class="text-center mb-16">
      <span class="tag-pill bg-deep mb-4 inline-flex" data-i18n="contact.label">07 — CONTACT</span>
      <h2 class="section-title reveal" data-i18n="contact.title">Get in Touch</h2>
      <p class="section-subtitle reveal reveal-delay-1 mx-auto" data-i18n="contact.subtitle">
        Have a question, collaboration idea, or just want to say hi? I'd love to hear from you.
      </p>
    </div>

    <div class="max-w-xl mx-auto reveal reveal-delay-2">
      <div class="bold-card p-8 md:p-10">
        <div class="flex flex-col gap-4">
          <!-- GitHub -->
          <a href="https://github.com/lilylist" target="_blank" class="flex items-center gap-4 p-5 rounded-xl border-2 border-charcoal hover:bg-electriclight hover:border-electric transition-all duration-300 group hover:shadow-[4px_4px_0px_#6C5CE7]">
            <div class="w-10 h-10 md:w-12 md:h-12 bg-charcoal rounded-xl flex items-center justify-center group-hover:bg-electric transition-colors shrink-0">
              <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            </div>
            <div class="flex-1">
              <div class="font-display font-black text-charcoal group-hover:text-electric transition-colors" data-i18n="contact.github">GitHub</div>
              <div class="text-sm text-gray font-mono">@lilylist</div>
            </div>
            <svg class="w-5 h-5 text-lightgray group-hover:text-electric group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>

          <!-- Email -->
          <a href="mailto:hello@lilylist.com" class="flex items-center gap-4 p-5 rounded-xl border-2 border-charcoal hover:bg-corallight hover:border-coral transition-all duration-300 group hover:shadow-[4px_4px_0px_#FF6B6B]">
            <div class="w-12 h-12 bg-charcoal rounded-xl flex items-center justify-center group-hover:bg-coral transition-colors">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div class="flex-1">
              <div class="font-display font-black text-charcoal group-hover:text-coral transition-colors" data-i18n="contact.email">Email</div>
              <div class="text-sm text-gray font-mono">hello@lilylist.com</div>
            </div>
            <svg class="w-5 h-5 text-lightgray group-hover:text-coral group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>

          <!-- Copy email -->
          <button onclick="navigator.clipboard.writeText('hello@lilylist.com'); window.showToast('Email copied!', 'success')" class="flex items-center gap-4 p-5 rounded-xl border-2 border-dashed border-lightgray hover:border-hotpink hover:bg-pinklight transition-all duration-300 group hover:shadow-[4px_4px_0px_#FD79A8]" aria-label="Copy email address to clipboard">
            <div class="w-12 h-12 bg-charcoal rounded-xl flex items-center justify-center group-hover:bg-hotpink transition-colors">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
              </svg>
            </div>
            <div class="flex-1 text-left">
              <div class="font-display font-black text-charcoal group-hover:text-hotpink transition-colors">Copy Email</div>
              <div class="text-sm text-gray">Tap to copy to clipboard</div>
            </div>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
